CAMPAIGN "Real Email Demo"

SET TONE = FRIENDLY
SET LENGTH = SHORT
SET SENDER = "ReachScript AI"
SET SUBJECT = "ReachScript Real Email Test"
SET DRY_RUN = FALSE

LOAD LEADS FROM "demo_leads.csv"

FOR EACH LEAD

    VERIFY COMPANY
    RESEARCH COMPANY
    PERSONALIZE EMAIL
    PREVIEW EMAIL
    SEND EMAIL

END