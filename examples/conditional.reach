CAMPAIGN "Verified Outreach"

SET TONE = FRIENDLY
SET LENGTH = SHORT
SET SENDER = "ReachScript AI"
SET SUBJECT = "AI Automation Opportunity"
SET DRY_RUN = TRUE

LOAD LEADS FROM "leads.csv"

FOR EACH LEAD

    VERIFY COMPANY
    RESEARCH COMPANY

    IF VERIFIED AND RESEARCH_VALID
        PERSONALIZE EMAIL
        PREVIEW EMAIL
        SEND EMAIL
    ELSE
        PREVIEW EMAIL
    END

END